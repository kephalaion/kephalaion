/k-playbook/

# Tasks, Befunde, Doku und persönliche Abläufe: eigenes, privates Repo
# kephalaion/kephalaion-dev, gesichert mit make -C k-playbook-local sichern.
/k-playbook-local/

# Von k-playbook je Rechner geschrieben, enthält den Pfad des Binarys
/.mcp.json
/.cursor/mcp.json
/opencode.json

# Build-Ausgabe von make dist
/dist/

# Die Erweiterung für VS Code zum Einbetten, gebaut von make vscode-vsix
/internal/vscodeext/vsix/*.vsix

# Abdeckung aus make cover
/coverage/

# Protokolle und Seiten-Snapshots des Playwright-MCP-Servers
/.playwright-mcp/
